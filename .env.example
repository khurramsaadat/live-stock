# Which feed the dashboard connects to: mock | websocket | polling | finnhub | twelvedata
NEXT_PUBLIC_MARKET_FEED=mock

# Finnhub key from https://finnhub.io/dashboard
NEXT_PUBLIC_MARKET_API_KEY=your_finnhub_api_key

# Twelve Data key from https://twelvedata.com/account/api-keys
NEXT_PUBLIC_TWELVEDATA_KEY=your_twelve_data_api_key

# Streaming endpoint, used when NEXT_PUBLIC_MARKET_FEED=websocket
NEXT_PUBLIC_MARKET_WS_URL=

# REST quote endpoint, used when NEXT_PUBLIC_MARKET_FEED=polling
NEXT_PUBLIC_MARKET_POLL_URL=

# Finnhub quote endpoint. Override only for a proxy or a mock server.
NEXT_PUBLIC_FINNHUB_URL=https://finnhub.io/api/v1/quote

# Poll cadence in milliseconds, minimum 1000.
NEXT_PUBLIC_MARKET_POLL_MS=5000
