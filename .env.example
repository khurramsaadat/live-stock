# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Never commit real keys.
#
# These names are not prefixed with NEXT_PUBLIC on purpose. A NEXT_PUBLIC value
# is inlined into the JavaScript bundle, and in a desktop build that bundle
# ships inside the executable. Secrets belong on the Rust side, or in the OS
# credential store, and are read by a Tauri command.

# Which provider you are using, for example finnhub, twelvedata, polygon.
MARKET_PROVIDER=Finnhub 

# The key from your provider dashboard. Paste it here, never in chat.
MARKET_API_KEY=dbjjvnpr01qonjme4aigdbjjvnpr01qonjme4aj0

# Streaming endpoint, if your provider has one.
MARKET_WS_URL=

# REST endpoint, if you are polling instead.
MARKET_POLL_URL=

# Poll cadence in milliseconds, minimum 1000.
MARKET_POLL_MS=5000
